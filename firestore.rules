rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Platform Admin check (Owner UID or custom admin claim)
    function isPlatformAdmin() {
      return request.auth != null && (
        request.auth.uid == 'NjVurGH5w4TPl8qoJklLyage7UX2' ||
        request.auth.token.admin == true
      );
    }

    // ─── Users collection ───────────────────────────────────────────────
    // Each user can read/write their own document; platform admin can read for support.
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isPlatformAdmin());
      allow write: if request.auth != null && (request.auth.uid == userId || isPlatformAdmin());

      // ─── Subscription subcollection ─────────────────────────────────
      // Readable by owner and platform admin. Writable ONLY by Cloud Functions (Admin SDK).
      match /subscription/{subDoc} {
        allow read: if request.auth != null && (request.auth.uid == userId || isPlatformAdmin());
        allow write: if false; // Only Cloud Functions (admin SDK) can write
      }

      // ─── Payments subcollection ─────────────────────────────────────
      // Readable by owner and platform admin. Writable ONLY by Cloud Functions.
      match /payments/{paymentId} {
        allow read: if request.auth != null && (request.auth.uid == userId || isPlatformAdmin());
        allow write: if false; // Only Cloud Functions (admin SDK) can write
      }

      // ─── Orders subcollection ────────────────────────────────────────
      match /orders/{orderId} {
        allow read: if request.auth != null && (request.auth.uid == userId || isPlatformAdmin());
        allow write: if false; // Only Cloud Functions (admin SDK) can write
      }
    }

    // ─── Admin collection ───────────────────────────────────────────────
    // Platform admin can read dashboard data. Writes restricted to Cloud Functions.
    match /admin/{document=**} {
      allow read: if isPlatformAdmin();
      allow write: if false;
    }

    // ─── Default deny ───────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
