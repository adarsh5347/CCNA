# NetOps Command — Local & Backend Environment Variables
# Copy this file to .env or .runtimeconfig.json for local development.
# NEVER commit real secret keys to source control!

# ─── Firebase Web Client Configuration (Public identifiers) ─────────────────
FIREBASE_API_KEY=your_firebase_web_api_key_here
FIREBASE_AUTH_DOMAIN=ccna-prep-platform.firebaseapp.com
FIREBASE_PROJECT_ID=ccna-prep-platform
FIREBASE_STORAGE_BUCKET=ccna-prep-platform.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=738402326601
FIREBASE_APP_ID=1:738402326601:web:2fb22f32441b0856174798

# ─── Razorpay Configuration ────────────────────────────────────────────────
# Public Key ID (used in assets/js/config.js for client-side checkout modal)
RAZORPAY_KEY_ID=rzp_live_YOUR_KEY_ID_HERE

# Secret Key (used ONLY in Firebase Cloud Functions config)
# Configure via: firebase functions:config:set razorpay.key_id="..." razorpay.key_secret="..."
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_SECRET_KEY_HERE
RAZORPAY_WEBHOOK_SECRET=YOUR_RAZORPAY_WEBHOOK_SECRET_HERE
